{% extends 'layout/theme.twig' %}

{% block title %}{{ 'account.title' | t }} | {{ store.name }}{% endblock %}

{% block content %}
<div class="container">

  {% include 'snippets/breadcrumb.twig' with {
    'breadcrumbs': [{ 'name': 'account.title' | t, 'url': '#' }]
  } %}

  <div class="account-grid">

    {# ── Sidebar ─────────────────────────────────── #}
    <div class="account-sidebar">
      <div style="text-align:center;padding-bottom:18px;border-bottom:1px solid #ffffff12;margin-bottom:14px;">
        <div style="width:64px;height:64px;border-radius:50%;background:linear-gradient(135deg,var(--gold2),var(--gold));display:flex;align-items:center;justify-content:center;margin:0 auto 10px;font-size:26px;font-weight:900;color:#111;">
          {{ customer.first_name | first | upper | default('؟') }}
        </div>
        <b style="color:#eee;">{{ customer.first_name }} {{ customer.last_name }}</b>
        <p style="color:#888;font-size:13px;margin:4px 0 0;">{{ customer.email }}</p>
      </div>

      <a href="{{ customer.urls.account }}" class="active">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="12" cy="8" r="4"/><path d="M4 21c1.5-5 14.5-5 16 0"/></svg>
        {{ 'account.profile' | t }}
      </a>
      <a href="{{ customer.urls.orders | default('/account/orders') }}">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="3" y="3" width="18" height="18" rx="3"/><path d="M8 10h8M8 14h5"/></svg>
        {{ 'account.orders' | t }}
      </a>
      <a href="{{ store.urls.wishlist | default('/wishlist') }}">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M20.8 4.6c-1.8-1.7-4.6-1.5-6.3.4L12 7.7 9.5 5C7.8 3.1 5 2.9 3.2 4.6c-2 1.9-2 5.1 0 7l8.8 8.4 8.8-8.4c2-1.9 2-5.1 0-7z"/></svg>
        {{ 'account.title' | t }} — {{ 'wishlist.title' | t }}
      </a>
      <a href="{{ customer.urls.addresses | default('/account/addresses') }}">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M12 2C8.1 2 5 5.1 5 9c0 5.3 7 13 7 13s7-7.7 7-13c0-3.9-3.1-7-7-7Z"/><circle cx="12" cy="9" r="2.5"/></svg>
        {{ 'account.addresses' | t }}
      </a>
      <a href="{{ customer.urls.logout | default('/logout') }}" style="color:#ff5d5d;margin-top:12px;border-top:1px solid #ffffff12;padding-top:12px;">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4M16 17l5-5-5-5M21 12H9"/></svg>
        {{ 'account.logout' | t }}
      </a>
    </div>

    {# ── Main Content ─────────────────────────────── #}
    <div>
      <h2 style="color:var(--gold2);margin-top:0;">معلوماتي الشخصية</h2>

      <div style="display:grid;grid-template-columns:1fr 1fr;gap:16px;margin-bottom:24px;">
        <div class="form-group">
          <label>الاسم الأول</label>
          <input type="text" class="form-input" value="{{ customer.first_name }}">
        </div>
        <div class="form-group">
          <label>الاسم الأخير</label>
          <input type="text" class="form-input" value="{{ customer.last_name }}">
        </div>
        <div class="form-group">
          <label>البريد الإلكتروني</label>
          <input type="email" class="form-input" value="{{ customer.email }}">
        </div>
        <div class="form-group">
          <label>رقم الجوال</label>
          <input type="tel" class="form-input" value="{{ customer.mobile | default('') }}">
        </div>
      </div>

      <button class="btn">حفظ التعديلات</button>
    </div>

  </div>
</div>
{% endblock %}
