{% extends 'layout/theme.twig' %}

{% block title %}{{ 'account.login' | t }} | {{ store.name }}{% endblock %}

{% block content %}
<div class="container">
  <div class="auth-page">
    <div class="auth-box">
      <div class="logo" style="text-align:center;margin-bottom:22px;font-size:38px;">
        {{ store.name | split('') | first }}<span style="color:var(--gold);">{{ store.name | slice(1) }}</span>
      </div>

      <h2>{{ 'account.login' | t }}</h2>

      <salla-login-form>
        <div class="form-group">
          <label>{{ 'البريد الإلكتروني أو رقم الجوال' }}</label>
          <input type="text" name="username" class="form-input" placeholder="أدخل بريدك أو جوالك" autocomplete="username">
        </div>
        <div class="form-group">
          <label>كلمة المرور</label>
          <input type="password" name="password" class="form-input" placeholder="كلمة المرور" autocomplete="current-password">
        </div>
        <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:18px;">
          <a href="{{ store.urls.forgot_password | default('/forgot-password') }}" style="color:var(--gold2);font-size:13px;">نسيت كلمة المرور؟</a>
        </div>
        <button type="submit" class="btn" style="width:100%;padding:16px;">{{ 'account.login' | t }}</button>
      </salla-login-form>

      <p style="text-align:center;color:#888;margin-top:18px;font-size:14px;">
        ليس لديك حساب؟
        <a href="{{ store.urls.register | default('/register') }}" style="color:var(--gold2);">{{ 'account.register' | t }}</a>
      </p>
    </div>
  </div>
</div>
{% endblock %}
