{% extends 'layout/theme.twig' %}

{% block title %}{{ 'wishlist.title' | t }} | {{ store.name }}{% endblock %}

{% block content %}
<div class="container">

  {% include 'snippets/breadcrumb.twig' with {
    'breadcrumbs': [{ 'name': 'wishlist.title' | t, 'url': '#' }]
  } %}

  <div class="page-header">
    <h1>{{ 'wishlist.title' | t }}</h1>
  </div>

  {% if wishlist is defined and wishlist | length > 0 %}
    <section class="products" style="margin-top:20px;">
      {% for product in wishlist %}
        {% include 'snippets/product-card.twig' with { 'product': product } %}
      {% endfor %}
    </section>
  {% else %}
    <div class="empty-state">
      <svg viewBox="0 0 24 24" stroke-width="1.5">
        <path d="M20.8 4.6c-1.8-1.7-4.6-1.5-6.3.4L12 7.7 9.5 5C7.8 3.1 5 2.9 3.2 4.6c-2 1.9-2 5.1 0 7l8.8 8.4 8.8-8.4c2-1.9 2-5.1 0-7z"/>
      </svg>
      <h3>{{ 'wishlist.empty' | t }}</h3>
      <p>{{ 'wishlist.empty_desc' | t }}</p>
      <a href="{{ store.url | default('/') }}" class="btn" style="display:inline-block;margin-top:16px;">{{ 'cart.continue_shopping' | t }}</a>
    </div>
  {% endif %}

</div>
{% endblock %}
