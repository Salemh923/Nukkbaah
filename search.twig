{% extends 'layout/theme.twig' %}

{% block title %}{{ 'search.title' | t }} | {{ store.name }}{% endblock %}

{% block content %}
<div class="container search-page">

  {% include 'snippets/breadcrumb.twig' with {
    'breadcrumbs': [{ 'name': 'search.title' | t, 'url': '#' }]
  } %}

  {% if search.query %}
    <h2 class="search-title">
      {{ 'search.results_for' | t }}: <span>{{ search.query }}</span>
    </h2>
  {% else %}
    <h2 class="search-title">{{ 'search.title' | t }}</h2>
  {% endif %}

  {# ── Search Box ────────────────────────────────── #}
  <form method="get" action="{{ store.urls.search | default('/search') }}" style="margin-bottom:28px;">
    <div class="search-wrap" style="max-width:640px;">
      <span class="search-icon">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="11" cy="11" r="8"/><path d="M21 21l-4.35-4.35"/>
        </svg>
      </span>
      <input
        class="search"
        type="search"
        name="q"
        value="{{ search.query | default('') }}"
        placeholder="{{ 'general.search_placeholder' | t }}"
        autocomplete="off"
      >
    </div>
  </form>

  {% if search.results is defined and search.results | length > 0 %}
    <section class="products">
      {% for product in search.results %}
        {% include 'snippets/product-card.twig' with { 'product': product } %}
      {% endfor %}
    </section>

    {# Pagination #}
    {% if pagination is defined and pagination.total_pages > 1 %}
      <div class="pagination">
        {% if pagination.current_page > 1 %}
          <a class="page-num" href="{{ pagination.prev_url }}">‹</a>
        {% endif %}
        {% for i in 1..pagination.total_pages %}
          <a class="page-num {% if i == pagination.current_page %}active{% endif %}" href="{{ pagination.page_url(i) }}">{{ i }}</a>
        {% endfor %}
        {% if pagination.current_page < pagination.total_pages %}
          <a class="page-num" href="{{ pagination.next_url }}">›</a>
        {% endif %}
      </div>
    {% endif %}

  {% elseif search.query %}
    <div class="empty-state">
      <svg viewBox="0 0 24 24" stroke-width="1.5">
        <circle cx="11" cy="11" r="8"/><path d="M21 21l-4.35-4.35"/>
      </svg>
      <h3>{{ 'search.no_results' | t }} "{{ search.query }}"</h3>
      <p>{{ 'search.no_results_desc' | t }}</p>
      <a href="{{ store.url | default('/') }}" class="btn" style="display:inline-block;margin-top:16px;">{{ 'nav.home' | t }}</a>
    </div>
  {% endif %}

</div>
{% endblock %}
