{% extends 'layout/theme.twig' %}

{% block title %}{{ page.title }} | {{ store.name }}{% endblock %}
{% block meta_description %}{{ page.description | striptags | slice(0,160) | default(store.description) }}{% endblock %}

{% block content %}
<div class="container">

  {% include 'snippets/breadcrumb.twig' with {
    'breadcrumbs': [{ 'name': page.title, 'url': '#' }]
  } %}

  <div class="page-content">
    <h1>{{ page.title }}</h1>
    {{ page.content }}
  </div>

</div>
{% endblock %}
